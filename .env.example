# Copy to .env.local for development. In production set these in Vercel -> Project Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# NEVER put the service_role key in any NEXT_PUBLIC_ variable or in client code.

# Private operator console entry gate. Leave unset to keep the console unavailable.
# Use two different random values; never prefix these with NEXT_PUBLIC_.
# BRAINLAB_PRIVATE_ENTRY_PATH must be a single random URL segment, 32-128 chars.
# BRAINLAB_PRIVATE_ENTRY_TOKEN must be a separate random value of at least 32 chars.
BRAINLAB_PRIVATE_ENTRY_PATH=
BRAINLAB_PRIVATE_ENTRY_TOKEN=

# Server-only key required for trusted topic-test attempt creation and grading.
# Set in local .env.local / Vercel server environment only; NEVER use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# AI Providers (Gemini, Groq, OpenAI, Anthropic Claude, OpenRouter)
# -----------------------------------------------------------------------------
# Google AI Studio Gemini API Configuration
GEMINI_API_KEY=YOUR-GEMINI-API-KEY
GEMINI_MODEL=gemini-3-flash-preview

# Groq High-Speed LPU Inference
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OpenAI API (Optional: GPT-4o, GPT-4o-mini, o1, o3-mini)
OPENAI_API_KEY=

# Anthropic Claude API (Optional: Claude 3 Opus, Claude 3.5 Sonnet, Claude 3.7 Sonnet)
ANTHROPIC_API_KEY=

# OpenRouter Unified Gateway (Optional: Access to Claude, GPT-4, DeepSeek under one key)
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Live Video Infrastructure (Optional: Default is zero-config WebRTC)
# -----------------------------------------------------------------------------
# LiveKit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Agora
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Daily.co
DAILY_API_KEY=

# -----------------------------------------------------------------------------
# Bachs Payment Gateway (Sandbox & Production)
# Get credentials from Bachs Developer Portal: https://docs.bachs.io or https://app.bachs.io
# -----------------------------------------------------------------------------
# Secret API key (starts with sk_sandbox_ for sandbox or sk_live_ for production)
BACHS_API_KEY=
# Webhook signing secret (obtained from Bachs Dashboard -> Webhooks)
BACHS_WEBHOOK_SECRET=
# Environment: 'sandbox' or 'production'
BACHS_ENVIRONMENT=sandbox
# Default provider when student does not choose: 'bachs' or 'paystack'
DEFAULT_PAYMENT_PROVIDER=bachs

# -----------------------------------------------------------------------------
# Paystack Payment Gateway (Existing Provider)
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_LIVE_ENABLED=false
